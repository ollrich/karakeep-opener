{
  "manifest_version": 3,
  "name": "Karakeep Opener",
  "version": "1.2.0",
  "description": "Öffnet Karakeep-Lesezeichen mit einem bestimmten Tag automatisch als Tabs in Firefox und entfernt danach den Tag.",
  "browser_specific_settings": {
    "gecko": {
      "id": "karakeep-opener@eichhof.me",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage",
    "alarms",
    "idle"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "Karakeep jetzt abfragen",
    "default_icon": "icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
